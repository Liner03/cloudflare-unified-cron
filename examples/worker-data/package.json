{
  "name": "@unified-cron/example-worker-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.jsonc --port 8788 --inspector-port 9230",
    "dev:e2e": "wrangler dev --config wrangler.local.jsonc --port 8788 --inspector-port 9230",
    "build": "wrangler deploy --config wrangler.local.jsonc --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "types": "wrangler types --config wrangler.jsonc --strict-vars false worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply worker-data-local-db --local --config wrangler.local.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply BUSINESS_DB --remote --config wrangler.jsonc",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@unified-cron/contracts": "workspace:*",
    "@unified-cron/worker-sdk": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.5",
    "vitest": "4.1.11",
    "wrangler": "4.129.1"
  }
}
