{
  "name": "cloudflare-unified-cron",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test:unit": "pnpm --filter @unified-cron/contracts --filter @unified-cron/worker-sdk test",
    "test:integration": "pnpm --filter @unified-cron/platform test:integration",
    "test:e2e": "pnpm --filter @unified-cron/e2e test",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11",
    "wrangler": "4.129.1"
  }
}
