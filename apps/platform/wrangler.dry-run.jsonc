{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "unified-cron-platform-dry-run",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unified-cron-platform-dry-run-db",
      "database_id": "00000000-0000-0000-0000-000000000004",
      "migrations_dir": "migrations",
    },
  ],
  "services": [
    {
      "binding": "CRON_DATA",
      "service": "worker-data-local",
      "entrypoint": "CronEntrypoint",
    },
  ],
  "vars": {
    "APP_ENV": "development",
    "ADMIN_USERNAME": "admin",
    "PUBLIC_ORIGIN": "http://127.0.0.1:5173",
    "PLATFORM_INSTANCE_ID": "00000000-0000-4000-8000-000000000004",
    "BUILD_VERSION": "dry-run",
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
