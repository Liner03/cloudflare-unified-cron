{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "unified-cron-platform-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unified-cron-platform-local-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "CRON_DATA",
      "service": "worker-data-local",
      "entrypoint": "CronEntrypoint"
    }
  ],
  "vars": {
    "APP_ENV": "development",
    "AUTH_MODE": "local",
    "ACCESS_TEAM_DOMAIN": "https://local.cloudflareaccess.com",
    "ACCESS_AUD": "local",
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "PLATFORM_INSTANCE_ID": "00000000-0000-4000-8000-000000000001",
    "BUILD_VERSION": "local"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
